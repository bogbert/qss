def extract_info_from_inst_name(default_env, account, region, az, name, templates)
    env = short_name = nil
    templates.each do |tplt|
        res = name.match(tplt['regex'])
        if res
            env_cfg = tplt['env'] || default_env
            inst_cfg = tplt['inst'] || '<%= inst_name %>'
            erb_vars = {match: res, account: account, region: region, az: az, inst_name: name}

            env = env_cfg.is_a?(Integer) ? res[env_cfg] : erb_eval(env_cfg, erb_vars)
            short_name = inst_cfg.is_a?(Integer) ? res[inst_cfg] : erb_eval(inst_cfg, erb_vars)

            break # Exit loop once a template matches
        end
    end

    return [(env || default_env).downcase, (short_name || name).downcase]
end

