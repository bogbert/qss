def read_user_input
    return STDIN.gets.strip
rescue Interrupt
    puts "\nAborted by user"
    exit 6
end

##########################################################################

def ask_for_yes_no(msg, auto_yes = false, default = true, output: $stdout)
    full_msg = "#{msg} #{default ? '[Y/n]' : '[y/N]'} "
    user_response = nil
    loop do
        output.print full_msg
        if auto_yes
            output.puts "(auto-yes)"
            return true
        end
        user_response = read_user_input.downcase
        output.puts
        return default if user_response.empty? && !default.nil?
        break if user_response =~ /^(y(es)?|n(o)?)$/i
        output.puts "You answered '#{user_response}' and it is not clear if that was supposed to be a yes or a no, let's try again."
    end
    return !(user_response =~ /^n/i)
end

