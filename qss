    default_env:      '.',
    default_regions:  ['us-east-1'],
    group_by_region:  false,
    db_filepath:      '~/.qss.db',
    connect_command:  ['aws', '--profile', '<%= profile %>', '--region', '<%= region %>', 'ssm', 'start-session', '--target', '<%= instance_id %>'],
    tunnel_command:   ['aws', '--profile', '<%= profile %>', '--region', '<%= region %>', 'ssm', 'start-session', '--target', '<%= instance_id %>', '--document-name', '<%= tunnel_document %>', '--parameters', '<%= tunnel_parameters %>'],
    exec_command:     ['aws', '--profile', '<%= profile %>', '--region', '<%= region %>', 'ssm', 'start-session', '--target', '<%= instance_id %>', '--document-name', 'AWS-StartInteractiveCommand', '--parameters', 'command=["<%= exec_cmd %>"]'],
    connect_env_vars: {}
}

begin
    opts = ::GetoptLong.new(
        [ '--refresh',         '-r', ::GetoptLong::NO_ARGUMENT ],
        [ '--list',            '-l', ::GetoptLong::NO_ARGUMENT ],
        [ '--info',            '-i', ::GetoptLong::NO_ARGUMENT ],
        [ '--install-completion',    ::GetoptLong::NO_ARGUMENT ],
        [ '--get-id',          '-g', ::GetoptLong::NO_ARGUMENT ],
        [ '--all',             '-A', ::GetoptLong::NO_ARGUMENT ],
        [ '--json',            '-j', ::GetoptLong::NO_ARGUMENT ],
        [ '--tunnel',          '-L', ::GetoptLong::REQUIRED_ARGUMENT ],
        [ '--exec',            '-e', ::GetoptLong::REQUIRED_ARGUMENT ],
        [ '--group_by_region', '-R', ::GetoptLong::NO_ARGUMENT ],
        [ '--group_by_env',    '-E', ::GetoptLong::NO_ARGUMENT ],
        [ '--verbose',         '-v', ::GetoptLong::NO_ARGUMENT ],
        [ '--yes',             '-y', ::GetoptLong::NO_ARGUMENT ],
        [ '--help',            '-h', ::GetoptLong::NO_ARGUMENT ],
        [ '--account',         '-a', ::GetoptLong::REQUIRED_ARGUMENT ],
        [ '--config',          '-c', ::GetoptLong::REQUIRED_ARGUMENT ]
    )
    opts.quiet = true  ## We don't want GetoptLong to display the error, we do it in the "rescue"

    opts.each do |opt, arg|
        case opt
        when '--refresh'            then mode = :refresh
                                         valid_argc = [0, 1, 2]
                                         mode_counter += 1
        when '--list'               then mode = :list
                                         valid_argc = [0, 1, 2]
                                         mode_counter += 1
        when '--info'               then mode = :info
                                         valid_argc = [0, 1, 2, 3]
                                         mode_counter += 1
        when '--install-completion' then mode = :install_completion
                                         valid_argc = [0]
                                         mode_counter += 1
        when '--get-id'             then mode = :get_id
                                         valid_argc = [3]
                                         mode_counter += 1
        when '--all'                then get_id_all = true
        when '--json'               then get_id_json = true
        when '--tunnel'             then tunnel_spec = arg
        when '--exec'               then exec_cmd    = arg
        when '--group_by_region'    then group_by_region_opt = true
        when '--group_by_env'       then group_by_region_opt = false
        ## Repeat the --verbose option twice to enable debug-level verbosity
        when '--verbose'            then $VERBOSE = true if $verbose # $VERBOSE = nil by default
                                         $verbose = true
        when '--yes'                then auto_yes = true
        when '--help'               then usage
        when '--config'             then config_filepath = default(arg, config_filepath)
        when '--account'            then account_opt = arg
        end
    end

    raise "Options --refresh, --list, --info, --get-id and --install-completion are mutually exclusive" if mode_counter > 1
    raise "Options --tunnel and --exec cannot be combined" if tunnel_spec && exec_cmd

    ## We have to read the config file before checking the number of arguments as the
    ## presence of a default account can change the expected number of arguments
    ## We don't want to trigger an error now if the config file is not valid
    begin
        config = read_config_file(config_filepath, config_defaults)
    rescue => config_error
        config = {}
    end

    account_name = default(account_opt || config[:default_account])
    valid_argc = valid_argc.map{ |argc| [argc - 1, 0].max } if account_name
    raise "Wrong argument number" unless valid_argc.include?(ARGV.size)

    account  = (account_name || ARGV.shift)&.downcase
    env      = ARGV[0]&.downcase
    instance = ARGV[1]&.downcase

    raise "Invalid environment name" if env && env.empty?
    raise "Invalid instance name" if instance && instance.empty?
rescue => error
    $stderr.puts "ERROR - Command line error: #{error}"
    usage(1)
end

raise config_error if config_error

##########################################################################

class QSSApp

def initialize(config:, account:, env:, instance:, auto_yes:, get_id_all:, get_id_json:, tunnel_spec:, exec_cmd:, group_by_region_opt:,
               std_script_name:, completion_dir_var:, completion_dirs:)
    @config              = config
    @account             = account
    @env                 = env
    @instance            = instance
    @auto_yes            = auto_yes
    @get_id_all          = get_id_all
    @get_id_json         = get_id_json
    @tunnel_spec         = tunnel_spec
    @exec_cmd            = exec_cmd
    @group_by_region_opt = group_by_region_opt
    @std_script_name     = std_script_name
    @completion_dir_var  = completion_dir_var
    @completion_dirs     = completion_dirs
end

def run(mode)
    send(mode)
end

private

################### Refresh the instance database
def refresh
    config   = @config
    account  = @account
    env      = @env
    auto_yes = @auto_yes

    ## Check if the default account points to a valid account
    if default(config[:default_account]) && !config[:all_accounts][config[:default_account]]
        $stderr.puts "Warning - The configured default account points to an account '#{config[:default_account]}' that does not exist in the configuration file"
    end

    ## Check template references
    all_tplt_refs = (config[:all_accounts].map{ |acc, prop| prop['templates'] || [] } + config[:default_templates]).flatten.uniq
    missing_tplts = all_tplt_refs.reject{ |tplt_name| config[:naming_templates][tplt_name] }
    $stderr.puts "Warning - The following template(s) are referenced but do not exist, they will be ignored: #{missing_tplts.join(', ')}" unless missing_tplts.empty?

    ## Check the template regexes
    config[:naming_templates].each do |tplt_name, tplt|
        regex_error = validate_regex(tplt['regex'])
        if regex_error
            $stderr.puts "Warning - Invalid regex in template '#{tplt_name}', this template will be ignored: #{regex_error}"
            config[:naming_templates].delete(tplt_name)
        end
    end

    ## Load the db file if it exists
    old_db = {}
    if File.exist?(config[:db_filepath])
        begin
            ## Read the old db
            old_db = load_database_file(config[:db_filepath], DATABASE_VERSION)
        rescue => error
            $stderr.puts "Warning - Database file '#{config[:db_filepath]}' cannot be read or is invalid: #{error}" if $verbose
            if account
                ## Prompt the user in case of error (unless he does a full refresh)
                puts "The database file '#{config[:db_filepath]}' cannot be read"
                puts "We will have to start from an empty database"
                exit unless ask_for_yes_no('Continue ?', auto_yes)
            end
        end
    end
    old_db_accounts = old_db['accounts'] || {}

    ## Prepare the new db hash and build the list of account/region pairs to process
    if account
        if !old_db.empty? && DATABASE_VERSION != old_db['version']
            puts "The current database has been created by a different version of the script, its compatibility is not guaranteed"
            puts "We recommend you perform a full refresh of the database, i.e. call the --refresh option without any account or environment"
            exit 20 unless ask_for_yes_no('Do you want to continue anyway ?', auto_yes, false)
        end

        ## Check if the account is present in the configuration file
        if config[:all_accounts][account]
            accounts_to_process = {account => config[:all_accounts][account]}
        else
            exit_on_error("Unknown account: #{account}", 21) unless old_db_accounts[account]
            puts "The account '#{account}' is not present in the configuration file, it will be deleted from the database"
            exit unless ask_for_yes_no('Continue ?', auto_yes)

            accounts_to_process = {}
        end

        db = old_db.clone
        db_accounts = old_db_accounts.clone
        db['accounts'] = db_accounts
        if env && config[:all_accounts][account]
            if db_accounts[account]
                ## Deep copy through Marshal serialization/deserialization
                db_accounts[account] = Marshal.load(Marshal.dump(old_db_accounts[account]))
                db_accounts[account].each{ |region, env_list| env_list.delete(env) }
            end
        else
            db_accounts.delete(account)
        end
    else
        db = {'version' => DATABASE_VERSION, 'accounts' => {}}
        db_accounts = db['accounts']

        ## Only keep in the new db the accounts that are ignored, all the others will be refreshed
        old_db_accounts.each do |acc_name, acc_data|
            db_accounts[acc_name] = acc_data if config[:all_accounts][acc_name] && config[:all_accounts][acc_name]['ignore']
        end

        accounts_to_process = config[:all_accounts].reject{ |acc, prop| prop['ignore'] } # Don't process accounts marked as ignored
    end
    reg_to_refresh = accounts_to_process.map do |acc, prop|
        (prop['regions'] || config[:default_regions]).map{ |reg| [acc, reg] }
    end.flatten(1)
    reg_num = reg_to_refresh.size
    max_acc_col_size = 30
    ## For account names longer than max_acc_col_size, we just give up on aligning them, they will look ugly :)
    acc_col_size = reg_to_refresh.map{ |acc, reg| "#{acc}/#{reg}".size }.reject{ |prefix_size| prefix_size > max_acc_col_size }.max || 0

    ## Fetch the instance names and process them
    ## Threads are used to speed up the process through parallelism, an account/region pair being the unit of work
    next_reg_index = 0
    thread_list = []
    mutex = Mutex.new
    [MAX_THREAD_NUM, reg_num].min.times do
        thread_list << Thread.new do
            loop do
                reg_index = nil
                mutex.synchronize do
                    reg_index = next_reg_index
                    next_reg_index += 1
                end
                break if reg_index >= reg_num
                (acc, reg) = reg_to_refresh[reg_index]

                templates = (config[:all_accounts][acc]['templates'] || config[:default_templates]).map{ |tplt_id| config[:naming_templates][tplt_id] }.compact

                instance_count = 0
                restore_old_db = false
                env_list = {}
                acc_prefix = "#{acc}/#{reg}".ljust(acc_col_size) + ' '
                begin
                    fetch_ec2_instances(acc, reg, config).each do |i|
                        name = i.tags.find{ |t| t.key == 'Name' }&.value
                        az = i.placement.availability_zone
                        (env_name, short_name) = extract_info_from_inst_name(config[:default_env], acc, reg, az, name || '', templates)
                        next if env && env != env_name
                        if env_name == '' || short_name == ''
                            puts "#{acc_prefix}Instance skipped: #{name || '<unnamed>'} (#{i.instance_id}) -> #{i.state.name}" if $verbose
                            next
                        end
                        instance_count += 1
                        puts "#{acc_prefix}Instance found: #{env_name}/#{short_name} - #{name || '<unnamed>'} (#{i.instance_id}) -> #{i.state.name}" if $verbose
                        env_list[env_name] ||= {}
                        env_list[env_name][short_name] = (env_list[env_name][short_name] || []) | [name] # union
                    end
                rescue => error
                    $stderr.puts "#{acc_prefix}ERROR: #{error}"

                    ## Restore the old db
                    env_list = (old_db_accounts[acc] && old_db_accounts[acc][reg]) ? old_db_accounts[acc][reg] : {}
                    restore_old_db = true
                end

                ## Update the db with the found instances
                mutex.synchronize do
                    db_accounts[acc] ||= {}
                    if env
                        if env_list[env].nil? || env_list[env].empty?
                            puts "#{acc_prefix}Env #{env} not found" unless restore_old_db
                        else
                            db_accounts[acc][reg] ||= {}
                            db_accounts[acc][reg][env] = env_list[env]
                            puts "#{acc_prefix}Env #{env} found (#{instance_count} instances)" unless restore_old_db
                        end
                    else
                        if env_list.empty?
                            puts "#{acc_prefix}No instances found" unless restore_old_db
                        else
                            db_accounts[acc][reg] = env_list
                            puts "#{acc_prefix}Envs: #{env_list.keys.sort.join(', ')} (#{instance_count} instances)" unless restore_old_db
                        end
                    end
                end
            end
        end
    end
    thread_list.each{ |t| t.join }; thread_list = []

    ## Timestamp the database
    db['latest_refresh'] = Time.now.strftime('%Y-%m-%d %H:%M:%S%z')

    ## Atomically write the new db file
    temp_db_filepath = "#{config[:db_filepath]}.#{Process.pid}.tmp" # Unique temp file name
    begin
        File.open(temp_db_filepath, 'w') do |f|
            f.write(JSON.pretty_generate(db))
        end

        if File.exist?(config[:db_filepath])
            backup_db_filepath = "#{config[:db_filepath]}.old"
            File.rename(config[:db_filepath], backup_db_filepath)
            puts "Backed up existing database to #{backup_db_filepath}" if $VERBOSE
        end

        File.rename(temp_db_filepath, config[:db_filepath])
        puts "Database refreshed successfully: #{config[:db_filepath]}"
    rescue => e
        $stderr.puts "ERROR - Failed to write database file: #{e.message}"
        begin
            File.delete(temp_db_filepath) if File.exist?(temp_db_filepath)
        rescue => cleanup_error
            $stderr.puts "Warning - Could not clean up temporary file: #{cleanup_error.message}"
        end
        exit 22
    end

    exit 0
end

################### List the instances from the database
def list
    config              = @config
    account             = @account
    env                 = @env
    instance            = @instance
    group_by_region_opt = @group_by_region_opt

    ## Load the database file
    begin
        db = load_database_file(config[:db_filepath], DATABASE_VERSION)
    rescue => error
        exit_on_error("Could not load database file: #{error}", 30)
    end

    ## Filter db content (keep only the relevant parts)
    begin
        db_accounts = filter_database(db['accounts'] || {}, config, account, env, instance)
    rescue => error
        exit_on_error(error.message, 31)
    end

    group_by_region = group_by_region_opt.nil? ? config[:group_by_region] : group_by_region_opt

    ## Process each account
    db_accounts.keys.sort.each do |acc|
        acc_data = db_accounts[acc]
        puts "\nACCOUNT: #{acc}"

        ## Count unique environments
        env_count = acc_data.values.flat_map(&:keys).uniq.size

        ## Count unique [env, short_name] pairs
        short_name_count = acc_data.flat_map{ |_region, reg_data|
            reg_data.flat_map{ |env, env_data| env_data.keys.map{ |name| [env, name] } }
        }.uniq.size

        ## Count unique [region, instance_name] pairs
        instance_name_count = acc_data.flat_map{ |region, reg_data|
            reg_data.flat_map{ |_env, env_data|
                env_data.flat_map{ |_short_name, inst_names|
                    inst_names.map{ |inst_name| [region, inst_name] }
                }
            }
        }.uniq.size

        ## Table Columns
        columns = group_by_region ? [['REGION', 20], ['ENV', 20]] : [['ENV', 20], ['REGION', 20]]
        columns += $verbose ? [["SHORT NAME", 50], ["INSTANCE NAME", 150]] : [["SHORT NAME", 150]]

        ## Swap the Region and Environment hierachy levels if required
        acc_data = swap_region_env_levels(acc_data) unless group_by_region

        ## Display the table
        display_table(hash_to_table(acc_data, columns.size), columns) unless acc_data.empty?

        ## Print account stats
        puts "Total: #{env_count} environments, #{short_name_count} short names, #{instance_name_count} instance names"
    end
    puts
end

################### Display information about the instances by querying EC2
def info
    config              = @config
    account             = @account
    env                 = @env
    instance            = @instance
    group_by_region_opt = @group_by_region_opt

    ## Load the database file
    begin
        db = load_database_file(config[:db_filepath], DATABASE_VERSION)
    rescue => error
        exit_on_error("Could not load database file: #{error}", 40)
    end

    ## Filter db content (keep only the relevant parts)
    begin
        db_accounts = filter_database(db['accounts'] || {}, config, account, env, instance)
    rescue => error
        exit_on_error(error.message, 41)
    end

    ## Fetch the instance info from EC2
    instance_info = fetch_ec2_inst_from_db_accounts(db_accounts, config, MAX_THREAD_NUM)

    ## Display the instance info
    indent = 4
    sep_width = 80
    group_by_region = group_by_region_opt.nil? ? config[:group_by_region] : group_by_region_opt

    ## lambda to display the region header, return true if an error is found
    display_region_header = -> (acc, reg, lvln_ident) do
        puts "\n#{' ' * lvln_ident}## REGION: #{reg}"

        if instance_info[[acc, reg]].first == :error
               puts "\n#{' ' * (lvln_ident + indent)}ERROR: #{instance_info[[acc, reg]].last}"
               return true
        end
        return false
    end

    ## lambda to display the environment header with the instance count
    display_env_header = -> (acc, env, env_data, lvln_ident) do
        env_instance_count = env_data.keys.sum do |reg|
            # Skip regions with errors
            next 0 if instance_info[[acc, reg]].first == :error

            instances_by_name = instance_info[[acc, reg]].last
            inst_names = env_data[reg].values.flatten.compact.uniq
            inst_names.flat_map{ |name| instances_by_name[name] || [] }.size
        end

        lvln_indent_str = ' ' * lvln_ident
        puts "\n#{lvln_indent_str}ENVIRONMENT: #{env} (#{env_instance_count} instances found)"
        puts "#{lvln_indent_str}#{'-' * (sep_width - lvln_ident)}"
    end

    ## Process each account
    db_accounts.keys.sort.each do |acc|
        acc_data = db_accounts[acc]

        ## Count unique environments
        env_count = acc_data.values.flat_map(&:keys).uniq.size
        env_count_msg = env ? '' : " (#{env_count} environments)"

        acc_sep = '=' * sep_width
        puts
        puts acc_sep
        puts "ACCOUNT: #{acc}#{env_count_msg}"
        puts acc_sep

        ## Swap the Region and Environment hierachy levels if required
        acc_data = swap_region_env_levels(acc_data) unless group_by_region

        ## Process each region or environment
        acc_data.sort.each do |lvl2, lvl2_data|
            if group_by_region
                region = lvl2
                next if display_region_header.call(acc, region, indent)
            else
                env = lvl2
                display_env_header.call(acc, env, lvl2_data, indent)
            end

            lvl2_data.sort.each do |lvl3, lvl3_data|
                if group_by_region
                    env = lvl3
                    display_env_header.call(acc, env, {region => lvl3_data}, indent * 2)
                else
                    region = lvl3
                    next if display_region_header.call(acc, region, indent * 2)
                end
                instances_by_name = instance_info[[acc, region]].last

                ## Display the instances
                lvl3_data.sort.each do |short_name, inst_names|
                    puts "\n#{' ' * (indent * 3)}- SHORT NAME: #{short_name}"
                    inst_names.sort.each do |inst_name|
                        instances = instances_by_name[inst_name]
                        unless (instances = instances_by_name[inst_name])&.any?
                            puts "\n#{(' ' * (indent * 3))}  . Name: #{inst_name} not found"
                            next
                        end
                        instance_count = instances.size
                        instances.sort_by(&:instance_id).each_with_index do |inst, i|
                            counter = instance_count > 1 ? " (#{i + 1}/#{instance_count})" : ''
                            inst_indent_str = ' ' * (indent * 3 + 2)
                            puts "\n#{inst_indent_str}. Name:  #{inst_name}#{counter}"
                            puts "#{inst_indent_str}  Id:    #{inst.instance_id}"
                            puts "#{inst_indent_str}  State: #{inst.state.name}"
                            if $verbose
                                puts "#{inst_indent_str}  Type:  #{inst.instance_type}"
                                puts "#{inst_indent_str}  AZ:    #{inst.placement.availability_zone}"
                                puts "#{inst_indent_str}  AMI:   #{inst.image_id}"
                                puts "#{inst_indent_str}  Launch Time: #{inst.launch_time.strftime('%Y-%m-%d %H:%M:%S%z')}"
                                puts "#{inst_indent_str}  Public DNS:  #{default(inst.public_dns_name, '<none>')}"
                                puts "#{inst_indent_str}  Private DNS: #{default(inst.private_dns_name, '<none>')}"
                                puts "#{inst_indent_str}  Public IP:   #{default(inst.public_ip_address, '<none>')}"
                                puts "#{inst_indent_str}  Private IP:  #{default(inst.private_ip_address, '<none>')}"
                                if instance
                                    puts
                                    puts "#{inst_indent_str}  Tags:#{' <none>' if inst.tags.empty?}"
                                    inst.tags.sort_by(&:key).each do |tag|
                                        puts "#{inst_indent_str}  . #{tag.key}: #{tag.value}"
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    puts
end

################### Open a SSM session to the instance
def connect
    config      = @config
    account     = @account
    env         = @env
    instance    = @instance
    auto_yes    = @auto_yes
    tunnel_spec = @tunnel_spec
    exec_cmd    = @exec_cmd

    ## Load the database file
    begin
        db = load_database_file(config[:db_filepath], DATABASE_VERSION)
    rescue => error
        exit_on_error("Could not load database file: #{error}", 50)
    end

    ## Filter db content (keep only the relevant parts)
    begin
        db_accounts = filter_database(db['accounts'] || {}, config, account, env, instance)
    rescue => error
        exit_on_error(error.message, 51)
    end

    ## Fetch the instance info from EC2
    instance_info = fetch_ec2_inst_from_db_accounts(db_accounts, config, MAX_THREAD_NUM)

    ## Process fetched instances
    instance_table = []   ## columns: [number, intance_id, status, region, name]
    eligible_instances = {}
    eligible_instances_count = 0
    rejected_instances_count = 0
    instance_info.sort.each do |(_acc, region), (status, output)|
        ## Instance names from database
        instance_candidates = db_accounts[account][region][env][instance].sort

        if status == :error
            $stderr.puts "#{account}/#{region}: ERROR - Could not fetch instance info: #{output}"
            instance_candidates.each do |inst_name|
                instance_table << ['', '', 'ERROR', region, inst_name]
            end
            rejected_instances_count += instance_candidates.size
            next
        end

        ## Instances fetched from EC2
        instances_by_name = output
        instance_candidates.each do |inst_name|
            if instances_by_name[inst_name].nil?
                rejected_instances_count += 1
                instance_table << ['', '', 'NOT FOUND', region, inst_name]
                next
            end

            instances_by_name[inst_name].sort_by(&:instance_id).each do |inst|
                state = inst.state.name
                if state == 'running'
                    eligible_instances_count += 1
                    eligible_instances[eligible_instances_count] = inst
                    inst_num = eligible_instances_count.to_s
                else
                    rejected_instances_count += 1
                    inst_num = ''
                end
                instance_table << [inst_num, inst.instance_id, state, inst.placement.availability_zone, inst_name]
            end
        end
    end

    if $verbose || eligible_instances_count > 1 || rejected_instances_count > 0
        ## Display the instance table
        puts "Found #{eligible_instances_count} running instance(s):"
        columns = [['#', 4], ['INSTANCE ID', 20], ['STATUS', 20], ['REGION / AZ', 20], ['NAME', 80]]
        display_table(instance_table, columns)
    end

    if eligible_instances_count == 0
        $stderr.puts "\nERROR - No running instance found for '#{account} / #{env} / #{instance}'"
        exit 52
    end

    if eligible_instances_count == 1
        target_instance = eligible_instances[1]
        if rejected_instances_count > 0
            ## Only one running instance found, but some others were rejected
            ## Ask the user if it's the instance he wants to connect to
            puts "\nThere is only one running instance [#{target_instance.instance_id}] but some others were not available"
            exit 53 unless ask_for_yes_no("Is it the one you want to connect to ?", auto_yes)
        end
    else
        ## More than one running instance found, ask the user to select one
        user_response = nil
        loop do
            puts "\nThere are #{eligible_instances_count} running instances"
            puts "Please enter a number in the range [1-#{eligible_instances_count}] or press Ctrl-C to abort"
            print "Your choice: "
            user_response = read_user_input
            puts
            break if user_response =~ /^\d+$/ && user_response.to_i.between?(1, eligible_instances_count)
            puts "Invalid choice: '#{user_response}', please try again"
        end
        target_instance = eligible_instances[user_response.to_i]
    end
    target_id   = target_instance.instance_id
    target_name = target_instance.tags.find{ |t| t.key == 'Name' }&.value || '<unnamed>'
    target_az   = target_instance.placement.availability_zone

    ## Parse tunnel spec into individual ERB variables (nil for all when not in tunnel mode)
    if tunnel_spec
        tunnel_parts = tunnel_spec.split(':')
        case tunnel_parts.size
        when 2
            tunnel_local_port, tunnel_remote_port = tunnel_parts
            tunnel_remote_host = nil
        when 3
            tunnel_local_port, tunnel_remote_host, tunnel_remote_port = tunnel_parts
        else
            exit_on_error("Invalid -L value '#{tunnel_spec}': expected local_port:remote_port or local_port:remote_host:remote_port", 56)
        end
        exit_on_error("Invalid -L value: '#{tunnel_local_port}' is not a valid port number",  57) unless tunnel_local_port  =~ /^\d+$/
        exit_on_error("Invalid -L value: '#{tunnel_remote_port}' is not a valid port number", 57) unless tunnel_remote_port =~ /^\d+$/

        if tunnel_remote_host.nil?
            tunnel_document   = 'AWS-StartPortForwardingSession'
            tunnel_parameters = JSON.generate({'portNumber' => [tunnel_remote_port], 'localPortNumber' => [tunnel_local_port]})
        else
            tunnel_document   = 'AWS-StartPortForwardingSessionToRemoteHost'
            tunnel_parameters = JSON.generate({'host' => [tunnel_remote_host], 'portNumber' => [tunnel_remote_port], 'localPortNumber' => [tunnel_local_port]})
        end
    else
        tunnel_local_port = tunnel_remote_host = tunnel_remote_port = tunnel_document = tunnel_parameters = nil
    end

    ## Build the ERB variables – all tunnel_* are nil when not in tunnel mode
    erb_vars = {
        account:            account,
        profile:            config[:all_accounts][account]['aws_profile'],
        region:             target_az[0..-2],
        az:                 target_az,
        env:                env,
        short_name:         instance,
        instance_id:        target_id,
        instance_name:      target_name,
        ec2_instance:       target_instance,
        tunnel_spec:        tunnel_spec,
        tunnel_local_port:  tunnel_local_port,
        tunnel_remote_host: tunnel_remote_host,
        tunnel_remote_port: tunnel_remote_port,
        tunnel_document:    tunnel_document,
        tunnel_parameters:  tunnel_parameters,
        exec_cmd:           exec_cmd,
    }

    ## Select the command template based on the active mode
    command_template = if tunnel_spec then config[:tunnel_command]
                       elsif exec_cmd then config[:exec_command]
                       else                config[:connect_command]
                       end
    connect_command = command_template.flat_map do |arg|
        begin
            result = erb_eval(arg, erb_vars)
            result.is_a?(Array) ? result : [result]
        rescue => error
            $stderr.puts "ERROR - Failed to process argument '#{arg}' of the command: #{error}"
            exit 54
        end
    end

    ## Process the environment variables
    connect_env_vars = config[:connect_env_vars].map do |var_name, var_value|
        begin
            val = erb_eval(var_value, erb_vars)
            raise "connect_env_vars value for '#{var_name}' must be a string" if val.is_a?(Array)
            [var_name, val]
        rescue => error
            $stderr.puts "ERROR - Failed to process environment variable '#{var_name}': #{error}"
            exit 55
        end
    end.to_h

    if $verbose
        ts = Time.now.strftime('%Y-%m-%d %H:%M:%S%z')
        if tunnel_spec
            dest = tunnel_remote_host ? "#{tunnel_remote_host}:#{tunnel_remote_port}" : "#{target_name}:#{tunnel_remote_port}"
            puts "#{ts} - Tunnel: local:#{tunnel_local_port} -> #{dest} via [#{target_id}]"
        elsif exec_cmd
            puts "#{ts} - Executing on [#{target_id}] #{target_name}: #{exec_cmd}"
        else
            puts "#{ts} - Connecting to instance [#{target_id}] #{target_name} ..."
        end
        puts "#{ts} - Command: #{connect_command.join(' ')}" if $VERBOSE
    end

    exec(connect_env_vars, *connect_command)
end

################### Retrieve the EC2 instance ID
def get_id
    config      = @config
    account     = @account
    env         = @env
    instance    = @instance
    auto_yes    = @auto_yes
    get_id_all  = @get_id_all
    get_id_json = @get_id_json

    ## Load the database file
    begin
        db = load_database_file(config[:db_filepath], DATABASE_VERSION)
    rescue => error
        exit_on_error("Could not load database file: #{error}", 70)
    end

    ## Filter db content (keep only the relevant parts)
    begin
        db_accounts = filter_database(db['accounts'] || {}, config, account, env, instance)
    rescue => error
        exit_on_error(error.message, 71)
    end

    ## Fetch the instance info from EC2
    instance_info = fetch_ec2_inst_from_db_accounts(db_accounts, config, MAX_THREAD_NUM)

    ## Process fetched instances
    instance_table = []   ## columns: [number, instance_id, status, region/az, name]
    eligible_instances = {}
    eligible_regions   = {}  ## region per eligible instance number (for JSON output)
    all_instances_json = []  ## all instances regardless of state (for --json --all)
    eligible_instances_count = 0
    rejected_instances_count = 0
    instance_info.sort.each do |(_acc, region), (status, output)|
        profile            = config[:all_accounts][account]['aws_profile']
        instance_candidates = db_accounts[account][region][env][instance].sort

        if status == :error
            $stderr.puts "#{account}/#{region}: ERROR - Could not fetch instance info: #{output}"
            instance_candidates.each do |inst_name|
                instance_table << ['', '', 'ERROR', region, inst_name]
                all_instances_json << {instance_id: nil, profile: profile, region: region, status: 'error'} if get_id_json && get_id_all
            end
            rejected_instances_count += instance_candidates.size
            next
        end

        instances_by_name = output
        instance_candidates.each do |inst_name|
            if instances_by_name[inst_name].nil?
                rejected_instances_count += 1
                instance_table << ['', '', 'NOT FOUND', region, inst_name]
                next
            end

            instances_by_name[inst_name].sort_by(&:instance_id).each do |inst|
                state = inst.state.name
                all_instances_json << {instance_id: inst.instance_id, profile: profile, region: region, status: state} if get_id_json && get_id_all
                if state == 'running'
                    eligible_instances_count += 1
                    eligible_instances[eligible_instances_count] = inst
                    eligible_regions[eligible_instances_count]   = region
                    inst_num = eligible_instances_count.to_s
                else
                    rejected_instances_count += 1
                    inst_num = ''
                end
                instance_table << [inst_num, inst.instance_id, state, inst.placement.availability_zone, inst_name]
            end
        end
    end

    columns = [['#', 4], ['INSTANCE ID', 20], ['STATUS', 20], ['REGION / AZ', 20], ['NAME', 80]]

    ## --json --all: output all instances (any state) as a JSON array, no interactive prompt
    if get_id_json && get_id_all
        $stderr.puts "Found #{all_instances_json.size} instance(s):" if $verbose
        puts all_instances_json.to_json
        return
    end

    if eligible_instances_count == 0
        $stderr.puts "\nERROR - No running instance found for '#{account} / #{env} / #{instance}'"
        exit 72
    end

    if get_id_all
        ## Non-interactive mode: print all running instance IDs, one per line on stdout
        if $verbose || rejected_instances_count > 0
            $stderr.puts "Found #{eligible_instances_count} running instance(s):"
            display_table(instance_table, columns, output: $stderr)
        end
        eligible_instances.each_value { |inst| puts inst.instance_id }
    else
        ## Interactive mode: user selects one instance if several candidates
        if $verbose || eligible_instances_count > 1 || rejected_instances_count > 0
            $stderr.puts "Found #{eligible_instances_count} running instance(s):"
            display_table(instance_table, columns, output: $stderr)
        end

        if eligible_instances_count == 1
            target_instance = eligible_instances[1]
            target_region   = eligible_regions[1]
            if rejected_instances_count > 0
                $stderr.puts "\nThere is only one running instance [#{target_instance.instance_id}] but some others were not available"
                exit 73 unless ask_for_yes_no("Is it the one whose ID you want to retrieve ?", auto_yes, output: $stderr)
            end
        else
            ## More than one running instance found, ask the user to select one
            user_response = nil
            loop do
                $stderr.puts "\nThere are #{eligible_instances_count} running instances"
                $stderr.puts "Please enter a number in the range [1-#{eligible_instances_count}] or press Ctrl-C to abort"
                $stderr.print "Your choice: "
                user_response = read_user_input
                $stderr.puts
                break if user_response =~ /^\d+$/ && user_response.to_i.between?(1, eligible_instances_count)
                $stderr.puts "Invalid choice: '#{user_response}', please try again"
            end
            target_instance = eligible_instances[user_response.to_i]
            target_region   = eligible_regions[user_response.to_i]
        end

        if get_id_json
            profile = config[:all_accounts][account]['aws_profile']
            puts({instance_id: target_instance.instance_id, profile: profile, region: target_region}.to_json)
        else
            puts target_instance.instance_id
        end
    end
end

################### Install bash completion script
def install_completion
    auto_yes           = @auto_yes
    std_script_name    = @std_script_name
    completion_dir_var = @completion_dir_var
    completion_dirs    = @completion_dirs

    completed_cmd = std_script_name
    current_script_name = ::File::basename($0)

    if std_script_name != current_script_name
        puts "It appears that the script has been renamed from '#{std_script_name}' to '#{current_script_name}'"
        completed_cmd = current_script_name if ask_for_yes_no("Do you want the completion script to be installed for the new name '#{current_script_name}' ?", auto_yes)
    end
    complete_command_line = "complete -F _qss_completion #{completed_cmd}"

    bash_completion_function = <<~'END_OF_COMPLETION_FUNCTION'
_qss_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    COMPREPLY=()

    # Build cur_prefix, the part of $cur before the cursor
    # It's the longest subchain being a $cur prefix and a $line_to_cursor suffix
    local line_to_cursor="${COMP_LINE:0:$COMP_POINT}"
    local line_len=${#line_to_cursor}
    local cur_len=${#cur}
    local max_prefix_size=$((cur_len < line_len ? cur_len : line_len))
    local cur_prefix=''
    local i
    for(( i=max_prefix_size; i>=0; i-- )); do
        local suffix="${line_to_cursor: -$i}"
        local prefix="${cur:0:$i}"
        if [[ "$suffix" == "$prefix" ]]; then
            cur_prefix="$prefix"
            break
        fi
    done

    # Completion for --config value
    if [[ "$prev" == "--config" || "$prev" =~ ^-[a-zA-Z]*c$ ]]; then
        COMPREPLY=( $(compgen -f -- "$cur_prefix") ) # Suggest files
        return 0
    fi

    # Build the list of arguments to pass to the ruby script
    # We only pass the words up to the current word
    # Words before the current word are expanded (e.g. quotes, variables, etc.)
    local words_to_ruby=()
    local processed_word
    for (( i=0; i < COMP_CWORD; i++ )); do
        eval "processed_word=${COMP_WORDS[i]}" 2>/dev/null
        words_to_ruby+=("$processed_word")
    done
    words_to_ruby+=("$cur")

    local completions=$(/usr/bin/env ruby - "${words_to_ruby[@]}"  <<'EOC'
        begin
            opt_mode_table = {
                '--refresh'            => :refresh,
                '-r'                   => :refresh,
                '--list'               => :list,
                '-l'                   => :list,
                '--info'               => :info,
                '-i'                   => :info,
                '--get-id'             => :get_id,
                '-g'                   => :get_id,
                '--install-completion' => :install_completion,
            }

            # For each mode: [<max number of positional args>, <list of mode specific options>]
            mode_info_table = {
                connect:            [3, opt_mode_table.keys + ['--tunnel', '-L', '--exec', '-e']],
                refresh:            [2, []],
                list:               [2, ['--group_by_region', '-R', '--group_by_env', '-E']],
                info:               [3, ['--group_by_region', '-R', '--group_by_env', '-E']],
                get_id:             [3, ['--all', '-A', '--json', '-j']],
                install_completion: [0, []],
            }

            # Analyze the command line arguments
            processing_options = true
            is_opt_value = nil
            opt_values = {}
            mode = :connect
            positional_args=[]
            ARGV[1..-2].each do |arg|
                if processing_options
                    if is_opt_value
                        opt_values[is_opt_value] = arg
                        is_opt_value = nil
                        next
                    end
                    if arg.start_with?('-')
                        if arg == '--'
                            processing_options = false
                            next
                        end
                        if arg == '--account' || arg =~ /^-[a-zA-Z]*a$/
                            is_opt_value = :account
                        elsif arg == '--config'  || arg =~ /^-[a-zA-Z]*c$/
                            is_opt_value = :config
                        elsif arg == '--tunnel' || arg == '-L'
                            is_opt_value = :tunnel
                        elsif arg == '--exec' || arg == '-e'
                            is_opt_value = :exec
                        end
                        mode = opt_mode_table[arg] || arg[/^-([a-zA-Z]{2,})$/, 1]&.chars&.lazy&.map{ |c| opt_mode_table["-#{c}"] }&.find(&:itself) || mode
                        next
                    end
                    processing_options = false
                end
                positional_args << arg
            end

            # Completion for options
            if processing_options && is_opt_value.nil? && ARGV[-1].start_with?('-')
                option_list = ['--verbose', '-v', '--help', '-h']
                option_list += mode_info_table[mode][1]
                option_list += ['--config', '-c'] unless opt_values[:config] || mode == :install_completion
                option_list += ['--account', '-a'] unless opt_values[:account] || mode == :install_completion
                print option_list.join("\n")
                exit 0
            end

            # No completion if all positional args are present
            # atm, we don't know if default_account is present in the config file so this test cannot handle all cases
            exit 0 if is_opt_value.nil? && positional_args.size + (opt_values[:account].nil? || opt_values[:account].empty? ? 0 : 1) >= mode_info_table[mode][0]

            def expand_env(str)
                # This regex substitutes $VAR, ${VAR} and %VAR% (Windows-style)
                str.gsub(/\$([a-zA-Z_][a-zA-Z0-9_]*)|\${\g<1>}|%\g<1>%/) { ENV[$1] }
            end

            default_config_file = '~/.qss.json'
            default_db_file     = '~/.qss.db'

            require 'json'
            config_file = opt_values[:config].nil? || opt_values[:config].empty? ? default_config_file : opt_values[:config]
            config = JSON.parse(File.read(File.expand_path(config_file)))
            db_file = expand_env(config['db_filepath'] || default_db_file)
            db = JSON.parse(File.read(File.expand_path(db_file)))
            db_accounts = db['accounts'] || {}

            account_name = opt_values[:account] || config['default_account'].to_s
            account_name = nil if account_name.empty?

            # No completion if all positional args are present (now we know if default_account is present in the config file)
            exit 0 if account_name && is_opt_value.nil? && positional_args.size + 1 >= mode_info_table[mode][0]

            account_name ||= positional_args.shift
            account_name = account_name&.downcase
            env_name = positional_args[0]&.downcase

            if is_opt_value == :account || account_name.nil?
                # Get the list of accounts
                account_list = db_accounts.keys.dup
                account_list |= config['accounts'].keys if mode == :refresh && config['accounts']
                print account_list.uniq.join("\n")
                exit 0
            end

            account = db_accounts[account_name] || {}

            unless env_name
                # Get the list of envs for the specified account
                env_list = account.map{ |reg, reg_data| reg_data.keys }.flatten.uniq
                print env_list.join("\n")
                exit 0
            end

            # Get the list of instances for the specified account and env
            instance_list = account.map{ |reg, reg_data| reg_data[env_name]&.keys }.compact.flatten.uniq
            print instance_list.join("\n")
    rescue => e
        $stderr.puts "qss completion error: #{e.message}" if ENV['QSS_COMPLETION_DEBUG']
    end
EOC
    )

    if [[ -n "$completions" ]]; then
        local IFS=$'\n'
        local -a precompreply
        precompreply=( $(compgen -W "${completions}" -- "$cur_prefix") )

        if [[ ${cur::1} == "'" || ${cur::1} == '"' ]]; then
            # The argument is already between quotes
            COMPREPLY=("${precompreply[@]}")
        else
            # Quote special characters (eg spaces)
            local comp
            for comp in "${precompreply[@]}"; do
                COMPREPLY+=("$(printf "%q" "$comp")")
            done
        fi
    fi
    return 0
}
END_OF_COMPLETION_FUNCTION

    bash_completion_script = bash_completion_function + "\n" + complete_command_line

    ## Try to find a directory candidate for the completion file
    completion_dirs.unshift(ENV[completion_dir_var]) if ENV[completion_dir_var] && !ENV[completion_dir_var].empty?
    completion_dir = completion_dirs.map{ |dir| File.expand_path(dir) }.find{ |dir| Dir.exist?(dir) }

    target_file_path = nil
    if completion_dir
        target_file_path = File.join(completion_dir, completed_cmd)

        puts "Found user bash completion directory: #{completion_dir}"
        puts "I propose to install the bash completion script as '#{target_file_path}'"
        puts "That file already exists, so it will be overwritten" if File.exist?(target_file_path)
        target_file_path = nil unless ask_for_yes_no('Do you want to proceed with the installation in this location?', auto_yes)
    end

    if target_file_path.nil?
        loop do
            ## Prompt the user for the target file path
            puts "Please specify the target file path for the bash completion script (e.g., ~/.bash_completion.d/qss)"
            print "Enter a path: "
            target_file_path_raw = read_user_input
            puts
            if target_file_path_raw.empty?
                puts "Try again or press Ctrl-C to cancel"
                puts
                next
            end

            ## Complete the path if it is a directory
            target_file_path = File.expand_path(target_file_path_raw)
            target_file_path = File.join(target_file_path, completed_cmd) if target_file_path_raw.end_with?('/') || File.directory?(target_file_path)

            if File.exist?(target_file_path)
                puts "The file already exists, it will be overwritten"
            else
                puts "The target directory does not exist, it will be created" unless File.exist?(File.dirname(target_file_path))
            end

            break if ask_for_yes_no("Please confirm the creation of the file '#{target_file_path}'", auto_yes)
            puts
            puts "You can press Ctrl-C to abort the script execution, or enter a new target file path"
            puts
        end
    end

    ## Ensure the target directory exists
    target_dir = File.dirname(target_file_path)
    unless Dir.exist?(target_dir)
        begin
            require 'fileutils' # Required for FileUtils.mkdir_p
            FileUtils.mkdir_p(target_dir)
            puts "Created directory: #{target_dir}" if $VERBOSE
        rescue SystemCallError => e
            exit_on_error("Could not create directory #{target_dir}: #{e.message}", 60)
        end
    end

    ## Write the completion script to the target file
    begin
        File.open(target_file_path, 'w') do |file|
            file.write(bash_completion_script)
        end
        puts "Bash completion script successfully installed to: #{target_file_path}"
        puts "Please source this file in your bash configuration (e.g., ~/.bashrc or ~/.bash_profile),"
        puts "or ensure it's in a directory scanned by bash-completion, then restart your shell or run:"
        puts "  source #{target_file_path}"
    rescue SystemCallError => e
        exit_on_error("Could not write to file #{target_file_path}: #{e.message}", 61)
    end

    exit 0
end

