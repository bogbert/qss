def usage(rc = 0)
    me = File.basename($0)
    output = (rc == 0) ? $stdout : $stderr

    output.puts %Q{\
.
. QSS - Quick SSM Session v1.1.0
. Usage: #{me} [options] <account> <env name> <instance short name>
.        #{me} --refresh [options] [<account> [<env name>]]
.        #{me} --list    [options] [<account> [<env name>]]
.        #{me} --info    [options] [<account> [<env name> [<instance short name>]]]
.        #{me} --get-id  [options] <account> <env name> <instance short name>
.        #{me} --install-completion
.
. Options --refresh, --list, --info, --get-id and --install-completion are actually
. commands in disguise, if none of them is specified, the script will try
. to connect to the instance which is the main purpose of this script.
.
. Note: If a default_account is configured in the configuration file,
.       the <account> parameter has to be omitted for all commands.
.       You can still override the default account with the --account/-a option.
.
. Options:
.   -r, --refresh         Refresh the instance database
.   -l, --list            List content of the instance database
.   -i, --info            Display information about instances
.   -g, --get-id          Retrieve the EC2 instance ID
.   -A, --all             Return all matching IDs without prompting (use with --get-id)
.   -j, --json            Output result as JSON: {instance_id, profile, region} (or array with status when combined with --all)
.   -L, --tunnel          Open a port-forwarding tunnel (format: local_port:remote_port or local_port:remote_host:remote_port)
.   -e, --exec            Execute a command on the instance interactively (cannot be combined with --tunnel)
.   -R, --group_by_region Group instances by account/region/env (use with --list and --info)
.   -E, --group_by_env    Group instances by account/env/region (use with --list and --info)
.   --install-completion  Install bash completion script
.   -a, --account         Specify account (overrides default_account from config)
.   -v, --verbose         Enable verbose mode
.   -y, --yes             Automatically agree to all yes/no questions
.   -h, --help            Display this help message
.   -c, --config          Specify the configuration file (default: ~/.qss.json)
.
. Examples:
.   # Without default_account configured:
.   #{me} dev staging app-server      # Connect to instance
.   #{me} --list dev                  # List instances in dev account
.
.   # With default_account configured (e.g., "dev"):
.   #{me} staging app-server          # Connect using default account
.   #{me} --list                      # List instances in default account
.   #{me} -a prod staging app-server  # Override default, use prod account
.
}

    exit(rc)
end

