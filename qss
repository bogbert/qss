## It is possible to search for a list of instance names
## Terminated instances are not included in the search
def fetch_ec2_instances(account_name, region, config, instance_names = nil, batch_size = 500)
    raise "Account '#{account_name}' not found in configuration" unless config[:all_accounts][account_name]

    ## If aws_profile is an empty string, no profile will be used
    ## This can be useful for example if qss is ran from an instance with a proper IAM role
    ec2_config = {region: region}
    ec2_config[:profile] = config[:all_accounts][account_name]['aws_profile'] unless config[:all_accounts][account_name]['aws_profile'].empty?
    ec2 = Aws::EC2::Resource.new(ec2_config)

    base_filters = [ { name: 'instance-state-name', values: ['pending', 'running', 'shutting-down', 'stopping', 'stopped'] } ]

    # If no instance names are provided, return all instances
    return ec2.instances(filters: base_filters).to_a if instance_names.nil? || instance_names.empty?

    all_instances = []
    instance_names.each_slice(batch_size) do |batch|
        filters = base_filters + [{ name: 'tag:Name', values: batch }]
        batch_instances = ec2.instances(filters: filters)
        all_instances.concat(batch_instances.to_a)
    end

    return all_instances
end

##########################################################################

## Input: accounts hash with structure:
##   {account_name => {region => {env_name => {short_name => [instance_names]}}}}
##
## Output: hash with structure:
##   {[account_name, region] => [:success, {instance_name => [instances]}] or [:error, error]}
def fetch_ec2_inst_from_db_accounts(accounts, config, max_thread_num = 20)
    instance_info = {}

    ## Build the list of account/region pairs to process + instance names
    reg_to_process = accounts.flat_map do |acc, acc_data|
        acc_data.map do |reg, reg_data|
            instance_names = reg_data.values.flat_map(&:values).flatten.compact.uniq
            if instance_names.empty?
                instance_info[[acc, reg]] = [:success, {}]
                next nil
            end
            [acc, reg, instance_names]
        end.compact
    end
    reg_num = reg_to_process.size

    ## Fetch the instance info from EC2
    ## Threads are used to parallelize API calls, with each thread processing one account/region pair at a time
    next_reg_index = 0
    thread_list = []
    mutex = Mutex.new
    [max_thread_num, reg_num].min.times do
        thread_list << Thread.new do
            loop do
                reg_index = nil
                mutex.synchronize do
                    reg_index = next_reg_index
                    next_reg_index += 1
                end
                break if reg_index >= reg_num
                (acc, reg, instance_names) = reg_to_process[reg_index]

                begin
                    instances_by_name = fetch_ec2_instances(acc, reg, config, instance_names).group_by do |i|
                        name = i.tags.find{ |t| t.key == 'Name' }&.value
                    end
                    result = [:success, instances_by_name]
                rescue => error
                    result = [:error, error]
                end

                mutex.synchronize do
                    instance_info[[acc, reg]] = result
                end
            end
        end
    end
    thread_list.each{ |t| t.join }

    return instance_info
end

