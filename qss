def truncate_text(text, max_width)
    return text if text.length <= max_width
    "#{text[0, max_width - 3]}..."
end

##########################################################################

def build_table_row_str(row, col_widths, sep)
    col_widths.each_with_index.with_object([]) do |(width, i), result|
        result << truncate_text((row[i] || '').to_s, width).ljust(width)
    end.join(sep)
end

##########################################################################

## Recursive function to build a table from a hash, meant to be used with display_hash_as_table
## The function builds a table of a given number of columns from a nested hash
## Arrays are supported but each element of the array is considered a final cell value (no array nesting)
## Call it like that:
## table = hash_to_table(data, column_number)
## Notice that for an empty hash, the resulting table will contain one empty row
def hash_to_table(data, col_number, depth = 0, prev_cols = [], table = [])
    if data.nil? || data.empty?
        ## Fill the rest of the row with empty cells
        table << (prev_cols + [''] * (col_number - depth))
        return table
    end

    col_padding = [''] * depth if data.size > 1

    ## Last column reached, add rows to the table
    if depth + 1 == col_number
        data.sort.each_with_index do |(key, _), i|
            cur_prev_cols = (i == 0) ? prev_cols : col_padding
            table << (cur_prev_cols + [key.to_s])
        end
        return table
    end

    ## For other columns, build rows up to the current column and do recusrive
    ## call to handle the next column
    data.sort.each_with_index do |(key, child_data), i|
        cur_prev_cols = (i == 0) ? prev_cols : col_padding
        hash_to_table(child_data, col_number, depth + 1, cur_prev_cols + [key.to_s], table)
    end
    return table
end

##########################################################################

## data is a hash, containing nested hashes, the depth of the nesting
## has to be bigger or equal to the number of columns
## For the last column, arrays are accepted instead of hashes
## columns format: [[<column name>, <column max width>], ...]
def display_table(table, columns, col_separator = ' | ', output: $stdout)
    ## Extract column names and widths
    col_number = columns.size
    col_names = columns.map{ |c| c[0] }
    col_min_widths = col_names.map(&:length)
    col_max_widths = columns.map{ |c| c[1] }

    ## Compute column actual widths + total table width
    col_widths = (0...col_number).map do |col|
        [(table.map{ |row| row[col].to_s.length } << col_min_widths[col]).max, col_max_widths[col]].min
    end
    table_width = col_widths.sum + col_separator.length * (col_number - 1)
    horiz_separator = '-' * table_width

    ## Print the table
    output.puts horiz_separator
    output.puts build_table_row_str(col_names, col_widths, col_separator)
    output.puts horiz_separator
    table.each{ |row| output.puts build_table_row_str(row, col_widths, col_separator) }
    output.puts horiz_separator
end

