def validate_config(config)
    ## The schema of the configuration file
    config_schema = {
        "type" => "object",
        "properties" => {
            ## The default environment name to use if not specified in the template definition
            ## It's also the environment name used if the instance name does not match any template
            ## Specify an empty string so that the instances are not indexed
            "default_env" => {"type" => "string"},
            ## The default regions to use if not specified in the account definition
            "default_regions" => {
                "type" => "array",
                "items" => { "type" => "string" }
            },
            ## The default templates to use if not specified in the account definition
            "default_templates" => {
                "type" => "array",
                "items" => { "type" => "string" }
            },
            ## Users who tend to use the same account most of the time can specify a default account
            ## They won't have to specify the account name on the command line
            ## If they ever want to use another account, they can specify it with the --account/-a option
            "default_account" => {
                "type" => "string",
                "pattern" => "^[^[:upper:]]*$"
            },
            ## If true, the instances are grouped by account/region/env, otherwise by account/env/region
            ## in the output of the --list and --info commands
            "group_by_region" => {"type" => "boolean"},
            "db_filepath" => {"type" => "string"},
            ## The command to use to connect to the instance
            ## The command is an array of strings, each string is an ERB template
            ## The following variables are available in the templates:
            ## account, profile, region, az, env, short_name, instance_id, instance_name, ec2_instance
            "connect_command" => {
                "type" => "array",
                "minItems" => 1,
                "items" => {
                    "type" => "string"
                }
            },
            ## The command to use to open a port-forwarding tunnel (-L option)
            ## Same ERB variables as connect_command, plus: tunnel_spec, tunnel_document, tunnel_parameters,
            ## tunnel_local_port, tunnel_remote_host, tunnel_remote_port
            "tunnel_command" => {
                "type" => "array",
                "minItems" => 1,
                "items" => {
                    "type" => "string"
                }
            },
            ## The command to use to execute a command on the instance interactively (-e option)
            ## Same ERB variables as connect_command, plus: exec_cmd
            "exec_command" => {
                "type" => "array",
                "minItems" => 1,
                "items" => {
                    "type" => "string"
                }
            },
            ## The environment variables to set before executing the connect command
            ## The variables are ERB templates, the following variables are available in the templates:
            ## account, profile, region, az, env, short_name, instance_id, instance_name, ec2_instance
            "connect_env_vars" => {
                "type" => "object",
                "patternProperties" => {
                    ".+" => {
                        "type" => "string"
                    }
                },
                "additionalProperties" => false
            },
            "accounts" => {
                "type" => "object",
                "patternProperties" => {
                    "^[^[:upper:]]+$" => {
                        "type" => "object",
                        "properties" => {
                            "aws_profile" => { "type" => "string" },
                            ## ignored accounts are not processed by :refresh, :list and :info modes
                            ## unless the account is explicitly specified on the command line
                            ## This is useful for accounts the user is only granted occasional access to (such as prod)
                            "ignore" => { "type" => "boolean" },
                            ## The regions to scan for this account
                            "regions" => {
                                "type" => "array",
                                "items" => { "type" => "string" }
                            },
                            ## The templates to apply to the instance names of this account
                            ## to extract the environment name and instance short name
                            ## Templates are applied in the order they are defined, the first match is used
                            "templates" => {
                                "type" => "array",
                                "items" => { "type" => "string" }
                            }
                        },
                        "required": ["aws_profile"]
                    }
                },
                "additionalProperties" => false
            },
            "naming_templates" => {
                "type" => "object",
                "patternProperties" => {
                    ".+" => {
                        "type" => "object",
                        "properties" => {
                            "regex" => { "type" => "string" },
                            ## The env and inst properties define the environment name and instance short name used on command line
                            ## Their values can be either an integer or a string:
                            ## . an integer is an index in the regex match
                            ## . a string is an ERB template that can use the following variables: match, account, region, inst_name
                            ##   example: "<%= match[1] %>.<%= region %>"
                            ## The matching instance is not indexed if either env or inst is an empty string
                            "env" => { "type" => ["integer", "string"] },
                            "inst" => { "type" => ["integer", "string"] }
                        },
                        "required": ["regex"]
                    }
                },
                "additionalProperties" => false
            }
        }
    }

    JSON::Validator.validate!(config_schema, config, :clear_cache => true)
end

##########################################################################

def read_config_file(config_filepath, defaults)
    config_filepath = File.expand_path(config_filepath)

    puts "Loading configuration file: #{config_filepath}" if $VERBOSE
    config_raw = File.read(config_filepath)
    config = JSON.parse(config_raw)
    validate_config(config)

    ## Build the configuration hash
    {
        default_env:        config['default_env'] || defaults[:default_env],
        default_regions:    config['default_regions'] || defaults[:default_regions],
        group_by_region:    config['group_by_region'].nil? ? defaults[:group_by_region] : config['group_by_region'],
        default_templates:  config['default_templates'] || [],
        default_account:    config['default_account'],
        db_filepath:        File.expand_path(expand_env(config['db_filepath'] || defaults[:db_filepath])),
        all_accounts:       config['accounts'] || {},
        naming_templates:   config['naming_templates'] || {},
        connect_command:    config['connect_command'] || defaults[:connect_command],
        tunnel_command:     config['tunnel_command']  || defaults[:tunnel_command],
        exec_command:       config['exec_command']    || defaults[:exec_command],
        connect_env_vars:   config['connect_env_vars'] || defaults[:connect_env_vars],
    }

rescue Errno::ENOENT
    exit_on_error("Configuration file not found: #{config_filepath}", 2)
rescue SystemCallError => e # Other file-related errors (e.g., permissions)
    exit_on_error("Error reading configuration file: #{config_filepath}\nError: #{e.message}", 3)
rescue JSON::ParserError => e
    exit_on_error("Invalid JSON in configuration file: #{config_filepath}\nError: #{e.message}", 4)
rescue JSON::Schema::ValidationError => e
    exit_on_error("Configuration file does not match schema: #{config_filepath}\nDetails: #{e.message}", 5)
end

##########################################################################

def exit_on_error(error, rc)
    $stderr.puts "ERROR - #{error}"
    exit(rc)
end

##########################################################################

# Return a default value (nil by default) if the value is nil or empty.
def default(value, default = nil)
    return default if value.nil? || value.empty?
    value
end

##########################################################################

def expand_env(str)
    ## This regex substitutes $VAR, ${VAR} and %VAR% (Windows-style)
    str.gsub(/\$([a-zA-Z_][a-zA-Z0-9_]*)|\${\g<1>}|%\g<1>%/) { ENV[$1] }
end

##########################################################################

# Validate a regex pattern
# Return nil if valid, otherwise return an error message
def validate_regex(pattern)
    Regexp.new(pattern)
    nil
rescue RegexpError => e
    e.message
end

##########################################################################

def load_database_file(db_filepath, db_version = nil)
    db_filepath = File.expand_path(db_filepath)
    puts "Loading the database file: #{db_filepath}" if $VERBOSE
    db_raw = File.read(db_filepath)
    db = JSON.parse(db_raw)
    if db_version && db['version'] != db_version
        $stderr.puts "Warning - Database version mismatch: expected #{db_version}, got #{db['version'] || '<no version>'}" if $VERBOSE
    end

    return db
end

##########################################################################

## Filter the database according to provided account / env / instance
## Ignored accounts are removed, unless for the filtered account
def filter_database(db_accounts, config, account = nil, env = nil, instance = nil)
    ## Filter by account if specified
    if account
        raise("Account '#{account}' not found in database") unless db_accounts[account]
        account_data = db_accounts[account].dup

        ## Filter by environment if specified
        if env
            account_data = account_data.select{ |region, reg_data| reg_data[env] }.transform_values{ |reg_data| {env => reg_data[env]} }
            raise("Environment '#{env}' not found in account '#{account}'") if account_data.empty?

            ## Filter by instance short name if specified
            if instance
                account_data = account_data.select{ |region, reg_data| reg_data[env][instance] }
                raise("Instance '#{instance}' not found in environment '#{account} / #{env}'") if account_data.empty?
                account_data = account_data.transform_values{ |reg_data| {env => {instance => reg_data[env][instance]}} }
            end
        end
        return {account => account_data}
    else
        return db_accounts.reject{ |acc, _| config[:all_accounts] && config[:all_accounts][acc] && config[:all_accounts][acc]['ignore'] }
    end
end

