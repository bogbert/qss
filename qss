def swap_region_env_levels(region_hash)
  region_hash.each_with_object({}) do |(region, reg_data), env_hash|
    reg_data.each do |env, short_names|
      # Initialize the environment hash if needed
      env_hash[env] ||= {}
      # Assign the short_names directly to the corresponding region
      env_hash[env][region] = short_names
    end
  end
end

