def get_binding_from_hash(h)
    os = OpenStruct.new(h.reject { |_, v| v.is_a?(Proc) || v.is_a?(Method) })
    h.each { |key, val| os.define_singleton_method(key, &val) if val.is_a?(Proc) || val.is_a?(Method) }
    os.instance_eval { binding }
end

##########################################################################

def erb_eval(template, variables = {})
  b = get_binding_from_hash(variables)
  ## For templates that are purely a single expression (<%= expr %>),
  ## return the raw Ruby value so that Array results can be flat-mapped
  ## into connect_command without going through Array#to_s.
  if (m = template.match(/\A\s*<%=\s*(.*?)\s*-?%>\s*\z/m))
    result = b.eval(m[1])
    return result if result.is_a?(Array)
    return result.nil? ? '' : result.to_s
  end
  ERB.new(template, trim_mode: '-').result(b)
rescue SyntaxError => e
  raise "Invalid ERB template: #{e.message}"
rescue => e
  raise "ERB evaluation failed: #{e.message}"
end

